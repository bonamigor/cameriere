# Railway / produção — exemplo (não versionar segredos reais)
# SPRING_PROFILES_ACTIVE=prod
# PORT=8080
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSL_MODE=REQUIRED            # conexão criptografada com o MySQL (padrão em prod)

# Obrigatório. Mínimo 32 caracteres. Gere com: openssl rand -base64 48
# JWT_SECRET=
# JWT_EXPIRATION_MS=28800000      # 8 horas

# Obrigatório em prod. Origens explícitas, sem '*'
# CORS_ALLOWED_ORIGINS=https://consumatore.vercel.app
# COOKIE_SECURE=true
