  "item": [
    {
      "name": "Auth",
      "description": "Login público (sem Bearer). Salva JWT em {{accessToken}}.",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cafeteriacentral.com\",\n  \"senha\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Obtém JWT ADMIN e salva em {{accessToken}}. Execute antes dos demais requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", json.accessToken);",
                  "  pm.environment.set(\"accessToken\", json.accessToken);",
                  "  if (json.usuarioId != null) pm.collectionVariables.set(\"usuarioId\", json.usuarioId);",
                  "  if (json.usuarioId != null) pm.environment.set(\"usuarioId\", json.usuarioId);",
                  "  if (json.clienteId != null) pm.collectionVariables.set(\"clienteId\", json.clienteId);",
                  "  if (json.clienteId != null) pm.environment.set(\"clienteId\", json.clienteId);",
                  "  if (json.role != null) pm.collectionVariables.set(\"role\", json.role);",
                  "  if (json.role != null) pm.environment.set(\"role\", json.role);",
                  "  console.log('Logado como', json.email, '(' + json.role + ')');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Operador USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
